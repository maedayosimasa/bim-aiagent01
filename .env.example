# docker-compose.yml が読み込む環境変数のサンプル。
# 実際の値を入れた .env をこのファイルと同じ場所に作成してください
# (.env はコミットしないこと)。

# Tailscale管理画面 (https://login.tailscale.com/admin/settings/keys) で
# 発行する再利用可能キー。tailscaleサービスがtailnetに参加するために使う。
TS_AUTHKEY=

# PC側ブリッジ(stdio->HTTPプロキシ)をTailscale越しに指すURL。
# 例: https://pc-archicad.tailnet-xxxx.ts.net/mcp
# 未設定でもbackendは起動するが、Archicad連携ツールはエラーを返す。
ARCHICAD_MCP_URL=
