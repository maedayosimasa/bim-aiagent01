# docker-compose.yml が読み込む環境変数のサンプル。
# 実際の値を入れた .env をこのファイルと同じ場所に作成してください
# (.env はコミットしないこと)。

# Tailscale管理画面 (https://login.tailscale.com/admin/settings/keys) で
# 発行する再利用可能キー。tailscaleサービスがtailnetに参加するために使う。
TS_AUTHKEY=

# PC側ブリッジ(stdio->HTTPプロキシ)をTailscale越しに指すURL。
# 例: https://pc-archicad.tailnet-xxxx.ts.net/mcp
# 未設定でもbackendは起動するが、Archicad連携ツールはエラーを返す。
ARCHICAD_MCP_URL=

# Legal Knowledge Builder(別リポジトリ、~/Legal Knowledge Builder/)が
# 公開する法令検索APIのURL。ローカルで`uv run legal-knowledge-builder serve`
# を起動している場合は http://127.0.0.1:8100 (POST /legal/connection で
# url: "local" を指定するのと同じ)。未設定でもbackendは起動するが、
# 法令検索ツール(/legal/*)はエラーを返す。
LEGAL_API_URL=

# AIエージェント(LangGraph、/agent/*)がClaudeを呼び出すためのAPIキー
# (https://console.anthropic.com/ で発行)。未設定でもbackendは起動するが、
# /agent/chat 等はエラーを返す(/agent/status で確認できる)。
ANTHROPIC_API_KEY=

# エージェントが使うモデル名。未設定なら claude-opus-5。
ANTHROPIC_AGENT_MODEL=

# 有効採光面積比の法定計算(engine/effective_daylighting.py、建築基準法
# 施行令20条)で使う用途地域カテゴリ。residential(住居系)/industrial
# (工業系)/commercial(商業系・無指定)のいずれか。BIMデータからは判定
# できない外部の都市計画情報のため、手動で指定する。未設定ならresidential。
LAND_USE_CATEGORY=

# フロントエンドを配信するオリジン(CORS許可リスト、カンマ区切りで複数可)。
# 例: https://bim.example.com,https://bim-staging.example.com
# 未設定ならローカル開発既定値(http://localhost:5173)のみ許可される。
# 本番(EC2等)ではフロントエンドの実際のURLを明示的に指定すること
# (未設定のまま本番デプロイすると全リクエストがCORSエラーになる)。
CORS_ALLOWED_ORIGINS=

# ブラウザから見たbackendの公開URL(frontend/src/api/client.ts参照)。
# 例: https://bim.example.com:8000
# ブラウザ側で評価される値のため、Dockerのコンテナ間ネットワークとは無関係
# (backend自身のコンテナ名では届かない)。未設定ならローカル開発既定値
# (http://localhost:8000)にフォールバックする。CORS_ALLOWED_ORIGINSと対に
# なる設定で、本番(EC2等)ではどちらも実際のURLを指定する必要がある。
VITE_API_BASE_URL=
